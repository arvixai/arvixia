# ============================================
# ARVIX IA - Variáveis de ambiente
# ============================================
# 1. Copie este arquivo e renomeie a cópia para ".env"
# 2. Cole sua chave da API da OpenAI no lugar indicado
# 3. NUNCA suba o arquivo ".env" (com a chave real) para o GitHub
#    (o .gitignore já está configurado para ignorá-lo)
# ============================================

# Sua chave de API da OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=coloque_sua_chave_aqui

# Modelo usado pela IA (opcional, padrão: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Porta do servidor (opcional, padrão: 3000)
PORT=3000

# Personalidade/instrução da IA (opcional)
ARVIX_SYSTEM_PROMPT=Você é a ARVIX IA, uma assistente profissional e prestativa.
